{
  "name": "vault-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "web:dev": "npm run dev -w apps/web",
    "web:build": "npm run build -w apps/web",
    "web:preview": "npm run preview -w apps/web",
    "web:lint": "npm run lint -w apps/web",
    "expo:start": "npm run start -w apps/ios-expo",
    "expo:ios": "npm run ios -w apps/ios-expo",
    "capacitor:sync": "cd apps/ios-capacitor && npx cap sync ios",
    "capacitor:open": "cd apps/ios-capacitor && npx cap open ios"
  }
}
